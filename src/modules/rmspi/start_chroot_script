# Source error handling, leave this in place
source /common.sh
install_cleanup_trap

# Detect boot directory (Bookworm uses /boot/firmware, older versions use /boot)
BOOT_DIR="/boot"
if [ -d "/boot/firmware" ]; then
  BOOT_DIR="/boot/firmware"
fi

# Unpack boot filesystem overlay
unpack /filesystem/boot "${BOOT_DIR}"

# Provide backwards-compatible symlink so both /boot/rmspi.txt and /boot/firmware/rmspi.txt work
if [ "${BOOT_DIR}" = "/boot/firmware" ] && [ -f "/boot/firmware/rmspi.txt" ]; then
  ln -sf /boot/firmware/rmspi.txt /boot/rmspi.txt
fi

apt-get update

# in case we are building from a regular raspbian image instead of the lite one...
remove_extra=$(remove_if_installed scratch squeak-plugins-scratch squeak-vm wolfram-engine python-minecraftpi minecraft-pi sonic-pi oracle-java8-jdk bluej libreoffice-common libreoffice-core freepats greenfoot nodered)
if [ -n "$remove_extra" ]; then
  echo "removing:" $remove_extra
  apt-get remove -y --purge $remove_extra
  apt-get autoremove -y
fi

apt-get -y install git tmux net-tools psmisc

# Config for TNCPi
BOOT_CMDLINE="${BOOT_DIR}/cmdline.txt"
BOOT_CONFIG="${BOOT_DIR}/config.txt"

if [ -f "${BOOT_CMDLINE}" ]; then
  sed -i 's/console=serial0,115200 //' "${BOOT_CMDLINE}"
fi

if [ -f "${BOOT_CONFIG}" ]; then
  if ! grep -q "^enable_uart=1" "${BOOT_CONFIG}"; then
    echo 'enable_uart=1' >> "${BOOT_CONFIG}"
  fi
fi

echo "--- Installing AX25"
apt-get -y install libax25 ax25-tools ax25-apps

if [ "$RMSPI_INCLUDE_RMSGW" == "yes" ]
then
  echo "--- Installing RMSGW"
  
  # create the group for the gateway if not existing
  echo "Creating group rmsgw..."
  getent group rmsgw >/dev/null || groupadd rmsgw

  # create the gateway user if not existing
  echo "Creating user rmsgw..."
  id -u rmsgw >/dev/null 2>&1 || useradd -s /bin/false -g rmsgw rmsgw

  # lock the account to prevent a potential hole, unless the owner is root
  echo "Locking user account rmsgw..."
  passwd -l rmsgw >/dev/null
  # while the account is locked, make the password never expire so that cron will be happy
  chage -E-1 rmsgw >/dev/null
  
  echo "Installing RMSGW Deps"
  apt-get -y install xutils-dev libxml2 libxml2-dev python3 python3-requests python3-packaging python3-urllib3 build-essential libax25-dev libx11-dev zlib1g-dev libncurses-dev binutils make csh g++ sed gawk autoconf automake autotools-dev
  echo "Deps Installed"
  
  TARGET_USER="${BASE_USER:-pi}"
  TARGET_HOME="/home/${TARGET_USER}"
  mkdir -p "${TARGET_HOME}"
  pushd "${TARGET_HOME}"
    gitclone RMSPI_RMSGW_REPO rmsgw
    pushd rmsgw
      chown -R "${TARGET_USER}:${TARGET_USER}" .
      sudo -u "${TARGET_USER}" ./autogen.sh
      sudo -u "${TARGET_USER}" ./configure
      sudo -u "${TARGET_USER}" make
      make install
    popd
  popd
  if [ ! -d /etc/rmsgw ]
  then
    ln -s /usr/local/etc/rmsgw /etc/rmsgw
  fi

  chown -R rmsgw:rmsgw /usr/local/etc/rmsgw 2>/dev/null || true
  [ -f /etc/rmsgw/winlinkservice.xml ] && chown rmsgw:rmsgw /etc/rmsgw/winlinkservice.xml
  [ -f /etc/rmsgw/stat ] && chown rmsgw:rmsgw /etc/rmsgw/stat

  # Add RMS_ACI to Crontab
  echo "6,36 *  * * *   rmsgw    /usr/local/bin/rmsgw_aci > /dev/null 2>&1" >> /etc/cron.d/rmspi
  # Install Logging
  cat << EOF > /etc/ax25/ax25d.conf
# RMS Gate
local0.info                     /var/log/rms
local0.debug                    /var/log/rms.debug
#local0.debug                   /dev/null
# (End)
EOF

fi

if [ "$RMSPI_XYL" == "yes" ]
then
  if ! id -u xyl >/dev/null 2>&1; then
    EXISTING_GROUPS=""
    for g in pi adm dialout cdrom sudo audio video plugdev games users input netdev gpio i2c spi; do
      if getent group "$g" >/dev/null; then
        EXISTING_GROUPS="${EXISTING_GROUPS}${EXISTING_GROUPS:+,}$g"
      fi
    done
    useradd -m -s /bin/bash ${EXISTING_GROUPS:+-G $EXISTING_GROUPS} xyl
  fi
fi

if [ "$RMSPI_INCLUDE_PAT" == "yes" ]
then
  DEB_ARCH="$(dpkg --print-architecture)"
  case "$DEB_ARCH" in
    arm64|aarch64)
      PAT_ARCH="arm64"
      ;;
    armhf|armv7l|armv6l)
      PAT_ARCH="armhf"
      ;;
    amd64|x86_64)
      PAT_ARCH="amd64"
      ;;
    *)
      PAT_ARCH="armhf"
      ;;
  esac

  PAT_DEB="pat_${RMSPI_PAT_VER}_linux_${PAT_ARCH}.deb"
  PAT_URL="https://github.com/la5nta/pat/releases/download/v${RMSPI_PAT_VER}/${PAT_DEB}"

  echo "--- Installing PAT (${PAT_DEB})"
  wget -O "${PAT_DEB}" "${PAT_URL}"
  dpkg -i "${PAT_DEB}" || apt-get install -fy
  rm -f "${PAT_DEB}"

  TARGET_USER="${BASE_USER:-pi}"
  systemctl_if_exists enable "pat@${TARGET_USER}.service"
  if [ "$RMSPI_XYL" == "yes" ]
  then
    systemctl_if_exists enable pat@xyl.service
  fi
fi

# Unpack root at the end, so files are modified before
unpack /filesystem/root /

echo "---Enable AX.25"
systemctl_if_exists enable ax25.service

### Fix SSH
grep -q "IPQoS" /etc/ssh/sshd_config 2>/dev/null || echo "IPQoS 0x00" >> /etc/ssh/sshd_config

### Try and fix https://github.com/guysoft/OctoPi/issues/424
### Thanks guysoft/OctoPi!
if [ -f /lib/systemd/system/regenerate_ssh_host_keys.service ]; then
  sed -i "s@ExecStart=/usr/bin/ssh-keygen -A -v@ExecStart=/bin/bash -c ' /usr/bin/ssh-keygen -A -v >> /var/log/regenerate_ssh_host_keys.log 2>\&1'@g" /lib/systemd/system/regenerate_ssh_host_keys.service
  sed -i "s@ExecStartPost=/bin/systemctl disable regenerate_ssh_host_keys@ExecStartPost=/bin/bash -c 'for i in /etc/ssh/ssh_host_*_key*; do actualsize=\$(wc -c <\"\$i\") ;if [ \$actualsize -eq 0 ]; then echo size is 0 bytes ; exit 1 ; fi ; done ; /bin/systemctl disable regenerate_ssh_host_keys'@g" /lib/systemd/system/regenerate_ssh_host_keys.service
fi
